{
  "name": "ai-orchestrator",
  "private": true,
  "engines": {
    "node": ">=22.13"
  },
  "version": "1.5.32",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "server": "tsx server/index.ts",
    "app": "npm run build && tsx server/index.ts",
    "server:restart": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/restart-server.ps1",
    "migrate:legacy": "tsx server/core/cli.ts",
    "start": "concurrently -n server,app -c yellow,cyan \"npm:server\" \"npm:dev\"",
    "test": "vitest run",
    "package": "powershell -ExecutionPolicy Bypass -File scripts/package-dist.ps1",
    "desktop": "electron electron/main.cjs",
    "dist:win": "npm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "express": "^4.21.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tsx": "^4.19.2",
    "ws": "^8.22.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.0",
    "autoprefixer": "^10.4.20",
    "concurrently": "^10.0.5",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "oxlint": "^1.79.0",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "main": "electron/main.cjs",
  "description": "AIオーケストラ",
  "author": "AI Orchestrator",
  "build": {
    "appId": "local.ai-orchestrator",
    "productName": "AIオーケストラ",
    "asar": false,
    "directories": {
      "output": "dist-installer"
    },
    "files": [
      "electron/**",
      "server/**",
      "!server/**/*.test.ts",
      "src/types/**",
      "dist/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "public/app-icon.ico",
        "to": "app-icon.ico"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/app-icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AIオーケストラ",
      "deleteAppDataOnUninstall": false
    }
  }
}
